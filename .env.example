# Copy to .env for `netlify dev`. In production set these in Netlify:
# Site configuration -> Environment variables.

# Required once, to create the first administrator at /admin. Any secret text, 16+ characters.
ADMIN_SETUP_KEY=

# Optional. Time zone that decides when each day ends at 00:00 (default America/Sao_Paulo).
CHAT_TIMEZONE=America/Sao_Paulo
